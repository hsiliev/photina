<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Photo gallery</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/nanogallery2/3.0.5/css/nanogallery2.min.css">
  <style>body{margin:0;padding:2rem;font:16px system-ui,sans-serif;background:#f5f5f5;color:#222}main{max-width:1400px;margin:auto}.album{margin:1rem 0}.album .album{margin-left:1.5rem;padding-left:1rem;border-left:2px solid #ddd}.album summary{display:flex;align-items:center;gap:.75rem;padding:.75rem 1rem;border:1px solid transparent;border-radius:.5rem;background:#fff;cursor:pointer;font-size:1.25rem}.album[open] summary{margin-bottom:1rem}.album-parent-marker{font-weight:700}.album-thumbnail{width:3rem;height:3rem;object-fit:cover}.photina-gallery{content-visibility:auto;contain-intrinsic-size:0 900px}.empty-gallery{text-align:center;margin:5rem auto;color:#666}.empty-gallery-icon{font-size:4rem}.nGY2GThumbnail,.nGY2GThumbnailContainer{box-sizing:border-box}.nGY2PopupContentLeft{box-sizing:border-box;max-width:680px!important;width:calc(100% - 2rem)!important}h1{font-weight:500}</style>
  <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/nanogallery2/3.0.5/jquery.nanogallery2.min.js"></script>
</head>
<body><main><h1>Photo gallery</h1>
<div id="photina-albums"></div>
<script>
const photinaAlbums = [__ALBUM_LIST__];
const photinaContainer = document.getElementById('photina-albums');
const showEmptyGallery = () => {
  photinaContainer.innerHTML = '<div class="empty-gallery"><div class="empty-gallery-icon">📁</div><p>No albums are available yet.</p></div>';
};

if (photinaAlbums.length === 0) {
  showEmptyGallery();
} else {
  const loadFragment = async url => {
    const response = await fetch(url);
    if (!response.ok) throw new Error(`Unable to load ${url}: ${response.status}`);
    return document.createRange().createContextualFragment(await response.text());
  };
  const activateAlbumThumbnail = details => {
    const image = details.querySelector(':scope > summary img[data-src]');
    if (image && !image.hasAttribute('src')) image.src = image.dataset.src;
  };
  const activateVisibleAlbumThumbnails = container => {
    container.querySelectorAll(':scope > details.album').forEach(activateAlbumThumbnail);
  };
  const initializeScripts = (scripts, forcedDetails = null, forcedActiveDetails = null) => scripts.forEach(script => {
      let initialized = false;
      const initialize = () => {
        if (initialized) return;
        initialized = true;
        Function(script.textContent)();
      };
      const details = script.closest('details');
      if (details) {
        const isActive = () => details.open ||
          (details === forcedDetails && forcedActiveDetails?.open);
        const initializeWhenOpen = () => {
          if (isActive()) setTimeout(initialize, 0);
        };
        details.addEventListener('toggle', initializeWhenOpen);
        const summary = details.querySelector(':scope > summary');
        summary?.addEventListener('click', () => {
          setTimeout(initializeWhenOpen, 0);
        }, {once:true});
        if (isActive()) setTimeout(initialize, 0);
      } else {
        initialize();
      }
    });
  const appendFragment = (container, fragment) => {
    const scripts = [...fragment.querySelectorAll('script')];
    container.append(fragment);
    initializeScripts(scripts);
  };
  const loadInto = async (container, url, unwrapRoot = false, isCurrent = () => true) => {
    const fragment = await loadFragment(url);
    if (!isCurrent()) return;
    if (unwrapRoot) {
      const root = fragment.firstElementChild?.matches('details.album')
        ? fragment.firstElementChild
        : fragment.querySelector('details.album');
      if (root) {
        const scripts = [...root.querySelectorAll('script')];
        root.querySelector(':scope > summary')?.remove();
        while (root.firstChild) container.append(root.firstChild);
        initializeScripts(scripts, root, container.closest('details'));
        activateVisibleAlbumThumbnails(container);
        return;
      }
    }
    appendFragment(container, fragment);
    activateVisibleAlbumThumbnails(container);
  };
  const renderAlbum = async album => {
    const details = document.createElement('details');
    details.className = 'album';
    const summary = document.createElement('summary');
    summary.className = 'album-parent';
    if (album.thumbnail) {
      const image = document.createElement('img');
      image.className = 'album-thumbnail';
      image.dataset.src = album.thumbnail;
      image.loading = 'lazy';
      image.alt = '';
      summary.append(image);
    }
    const marker = document.createElement('span');
    marker.className = 'album-parent-marker';
    marker.textContent = '>';
    const title = document.createElement('strong');
    title.textContent = album.title;
    summary.append(marker, title);
    const children = document.createElement('div');
    details.append(summary, children);
    activateAlbumThumbnail(details);
    let loaded = false;
    let loading = null;
    let loadGeneration = 0;
    const loadContents = () => {
      if (loaded || loading) return loading;
      const generation = ++loadGeneration;
      const isCurrent = () => details.open && generation === loadGeneration;
      loading = album.children
        ? Promise.allSettled(album.children.map(child => loadInto(children, child.url, false, isCurrent)))
        : loadInto(children, album.url, true, isCurrent).then(() => []);
      return loading.then(results => {
        if (!isCurrent()) return;
        loaded = true;
        if (album.children && results.every(result => result.status === 'rejected')) {
          children.textContent = 'Unable to load this album.';
        }
      });
    };
    details.addEventListener('toggle', () => {
      if (details.open) {
        loadContents();
      } else {
        loadGeneration++;
        children.replaceChildren();
        loaded = false;
        loading = null;
      }
    });
    if (!album.children) return {element: details};
    return {element: details};
  };
  Promise.allSettled(photinaAlbums.map(renderAlbum)).then(results => {
    const albums = results
      .filter(result => result.status === 'fulfilled' && result.value)
      .map(result => result.value);
    if (albums.length === 0) {
      showEmptyGallery();
      return;
    }
    albums.forEach(album => {
      if (album.fragment) appendFragment(photinaContainer, album.fragment);
      else photinaContainer.append(album.element);
    });
  });
}
</script>
</main></body>
</html>
