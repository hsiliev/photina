<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Photo gallery</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/nanogallery2/3.0.5/css/nanogallery2.min.css">
  <style>body{margin:0;padding:2rem;font:16px system-ui,sans-serif;background:#f5f5f5;color:#222}main{max-width:1400px;margin:auto}.album{margin:1rem 0}.album .album{margin-left:1.5rem;padding-left:1rem;border-left:2px solid #ddd}.album summary{display:flex;align-items:center;gap:.75rem;padding:.75rem 1rem;border:1px solid transparent;border-radius:.5rem;background:#fff;cursor:pointer;font-size:1.25rem}.album[open] summary{margin-bottom:1rem}.album-parent-marker{font-weight:700}.album-thumbnail{width:3rem;height:3rem;object-fit:cover}.nGY2GThumbnail,.nGY2GThumbnailContainer{box-sizing:border-box;background:#f5f5f5!important;width:__THUMBNAIL_SIZE__px!important;height:__THUMBNAIL_SIZE__px!important;border:1px solid transparent!important}.nGY2PopupContentLeft{box-sizing:border-box;max-width:680px!important;width:calc(100% - 2rem)!important}@media (max-width:900px){.nGY2GThumbnail,.nGY2GThumbnailContainer{width:200px!important;height:200px!important}}@media (max-width:600px){body{padding:1rem}.nGY2GThumbnail,.nGY2GThumbnailContainer{width:140px!important;height:140px!important}}h1{font-weight:500}</style>
  <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/nanogallery2/3.0.5/jquery.nanogallery2.min.js"></script>
</head>
<body><main><h1>Photo gallery</h1>
<div id="photina-albums"></div>
<script>
const photinaAlbums = [__ALBUM_LIST__];
const photinaContainer = document.getElementById('photina-albums');

if (photinaAlbums.length === 0) {
  photinaContainer.innerHTML = '<p>No albums found.</p>';
} else {
  const loadFragment = async url => {
    const response = await fetch(url);
    if (!response.ok) throw new Error(`Unable to load ${url}: ${response.status}`);
    return document.createRange().createContextualFragment(await response.text());
  };
  const appendFragment = (container, fragment) => {
    const scripts = [...fragment.querySelectorAll('script')];
    container.append(fragment);
    scripts.forEach(script => Function(script.textContent)());
  };
  const renderAlbum = async album => {
    if (!album.children) return {fragment: await loadFragment(album.url)};
    const details = document.createElement('details');
    details.className = 'album';
    const summary = document.createElement('summary');
    summary.className = 'album-parent';
    if (album.thumbnail) {
      const image = document.createElement('img');
      image.className = 'album-thumbnail';
      image.src = album.thumbnail;
      image.alt = '';
      summary.append(image);
    }
    const marker = document.createElement('span');
    marker.className = 'album-parent-marker';
    marker.textContent = '>';
    const title = document.createElement('strong');
    title.textContent = album.title;
    summary.append(marker, title);
    const children = document.createElement('div');
    details.append(summary, children);
    await Promise.all(album.children.map(async child => {
      appendFragment(children, await loadFragment(child.url));
    }));
    return {element: details};
  };
  Promise.all(photinaAlbums.map(renderAlbum)).then(albums => {
    albums.forEach(album => {
      if (album.fragment) appendFragment(photinaContainer, album.fragment);
      else photinaContainer.append(album.element);
    });
  }).catch(error => {
    photinaContainer.textContent = `Unable to load the gallery: ${error.message}`;
  });
}
</script>
</main></body>
</html>
