<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Photo gallery</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/nanogallery2/3.0.5/css/nanogallery2.min.css">
  <style>body{margin:0;padding:2rem;font:16px system-ui,sans-serif;background:#f5f5f5;color:#222}main{max-width:1400px;margin:auto}.album{margin:1rem 0}.album .album{margin-left:1.5rem;padding-left:1rem;border-left:2px solid #ddd}.album summary{display:flex;align-items:center;gap:.75rem;padding:.75rem 1rem;border:1px solid transparent;border-radius:.5rem;background:#fff;cursor:pointer;font-size:1.25rem}.album[open] summary{margin-bottom:1rem}.album-parent-marker{font-weight:700}.album-thumbnail{width:3rem;height:3rem;object-fit:cover}.empty-gallery{text-align:center;margin:5rem auto;color:#666}.empty-gallery-icon{font-size:4rem}.empty-gallery p{font-size:1.25rem}.nGY2GThumbnail,.nGY2GThumbnailContainer{box-sizing:border-box;background:#f5f5f5!important;width:__THUMBNAIL_SIZE__px!important;height:__THUMBNAIL_SIZE__px!important;border:1px solid transparent!important}.nGY2PopupContentLeft{box-sizing:border-box;max-width:680px!important;width:calc(100% - 2rem)!important}@media (max-width:900px){.nGY2GThumbnail,.nGY2GThumbnailContainer{width:200px!important;height:200px!important}}@media (max-width:600px){body{padding:1rem}.nGY2GThumbnail,.nGY2GThumbnailContainer{width:140px!important;height:140px!important}}h1{font-weight:500}</style>
  <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/nanogallery2/3.0.5/jquery.nanogallery2.min.js"></script>
</head>
<body><main><h1>Photo gallery</h1>
<div id="photina-albums"></div>
<script>
const photinaAlbums = [__ALBUM_LIST__];
const photinaContainer = document.getElementById('photina-albums');
const showEmptyGallery = () => {
  photinaContainer.innerHTML = '<div class="empty-gallery"><div class="empty-gallery-icon">📁</div><p>No albums are available yet.</p></div>';
};

if (photinaAlbums.length === 0) {
  showEmptyGallery();
} else {
  const loadFragment = async url => {
    const response = await fetch(url);
    if (!response.ok) throw new Error(`Unable to load ${url}: ${response.status}`);
    return document.createRange().createContextualFragment(await response.text());
  };
  const appendFragment = (container, fragment) => {
    const scripts = [...fragment.querySelectorAll('script')];
    container.append(fragment);
    scripts.forEach(script => {
      let initialized = false;
      const initialize = () => {
        if (initialized) return;
        initialized = true;
        Function(script.textContent)();
      };
      const details = script.closest('details');
      if (details) {
        const initializeWhenOpen = () => {
          if (details.open) setTimeout(initialize, 0);
        };
        details.addEventListener('toggle', initializeWhenOpen);
        const summary = details.querySelector(':scope > summary');
        summary?.addEventListener('click', () => {
          setTimeout(initializeWhenOpen, 0);
        }, {once:true});
        if (details.open) setTimeout(initialize, 0);
      } else {
        initialize();
      }
    });
  };
  const renderAlbum = async album => {
    if (!album.children) return {fragment: await loadFragment(album.url)};
    const details = document.createElement('details');
    details.className = 'album';
    const summary = document.createElement('summary');
    summary.className = 'album-parent';
    if (album.thumbnail) {
      const image = document.createElement('img');
      image.className = 'album-thumbnail';
      image.src = album.thumbnail;
      image.alt = '';
      summary.append(image);
    }
    const marker = document.createElement('span');
    marker.className = 'album-parent-marker';
    marker.textContent = '>';
    const title = document.createElement('strong');
    title.textContent = album.title;
    summary.append(marker, title);
    const children = document.createElement('div');
    details.append(summary, children);
    const results = await Promise.allSettled(album.children.map(child => loadFragment(child.url)));
    results.forEach(result => {
      if (result.status === 'fulfilled') appendFragment(children, result.value);
    });
    if (!children.hasChildNodes()) return null;
    return {element: details};
  };
  Promise.allSettled(photinaAlbums.map(renderAlbum)).then(results => {
    const albums = results
      .filter(result => result.status === 'fulfilled' && result.value)
      .map(result => result.value);
    if (albums.length === 0) {
      showEmptyGallery();
      return;
    }
    albums.forEach(album => {
      if (album.fragment) appendFragment(photinaContainer, album.fragment);
      else photinaContainer.append(album.element);
    });
  });
}
</script>
</main></body>
</html>
