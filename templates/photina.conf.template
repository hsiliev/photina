# Source photos, generated site, and persistent thumbnail cache.
ALBUMS_DIR=/mnt/gallery/albums
OUTPUT_DIR=/mnt/gallery/dist
THUMBNAILS_DIR=/mnt/gallery/thumbnails
METADATA_DIR=/mnt/gallery/metadata
CADDYFILE=/etc/caddy/Caddyfile

# Host and port settings
HOST=${HOST:-localhost}
PORT=${PORT:-443}

# Plaintext passwords are hashed by the gallery generators and are never written
# to Caddyfile. Keep this file private (chmod 600 /etc/photina/photina.conf).
ADMIN_PASSWORD=admin
GUEST_PASSWORD=guest

# Album paths guests may access. Paths can point to a top-level album or a
# nested album, for example "Greece/2026-08-01 - Σπήλαιο Πετραλώνων". Quote
# each item to preserve spaces and other characters.
GUEST_ALBUMS=(
  "Greece/Θεσσαλονίκη"
  "Sadovetz"
)

# Thumbnail width and height in pixels.
# Desktop thumbnail size; display sizes are capped at 120px below 480px
# and 180px below 992px. The selected layout's auto dimension is preserved.
THUMBNAIL_SIZE=250
MEDIUM_SIZE=1600

# Supported media extensions, without leading dots.
IMAGE_EXTENSIONS=(jpg jpeg png gif webp bmp tif tiff avif heic heif)
VIDEO_EXTENSIONS=(mp4 m4v mov mkv webm avi mpeg mpg ts mts)

# nanogallery2 thumbnail layout mode.
THUMBNAIL_DISPLAY_MODE=cascading
